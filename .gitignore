# Build output
/solarr
/dist/
/bin/
*.exe

# Web UI build artifacts (source lives in web/, output is embedded)
/web/node_modules/
/web/.vite/
/web/*.tsbuildinfo

# The production bundle is written here so it sits beside the Go package that
# embeds it. Everything in it is generated, so none of it is committed -- but the
# directory itself must exist or `go:embed` has no pattern to match and the build
# fails before anyone has run `make web`. Hence the kept placeholder.
/internal/api/webui/dist/*
!/internal/api/webui/dist/.gitkeep

# Runtime data — never committed
/data/
*.db
*.db-wal
*.db-shm
*.db-journal

# Local config: config.yml holds the encryption key (ADR-14)
/config.yml
config.local.yml

# Go
*.test
*.out
/vendor/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local-only working documents — never published
/private/
/CLAUDE.md
/AGENTS.md
/*.local.md


# Local-only test fixtures from the real library (never committed)
/private/fixtures/

# The generated ADR-28 benchmark corpus and the migration backups beside it. Big,
# reproducible from internal/db/library/fixture, and rebuilt on demand.
/internal/db/library/testdata/fixtures/

# Machine-specific Makefile overrides (DNS, image pins)
/Makefile.local

# The local standing test instance's own compose file -- host-specific paths
# (/mnt/media/music etc.), never portable, never committed
/docker-compose.test.yml

# Claude Code harness state, including worktree-isolated subagent checkouts
# (each a full nested working tree -- never something to commit)
/.claude/

# The smoke suite writes its report, screenshots and traces here.
web/e2e/out/
web/e2e/node_modules/
